{
  "name": "oleander",
  "version": "0.1.0",
  "description": "ZAP Witness Council CLI harness",
  "type": "module",
  "bin": {
    "zap": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "browser": "vite apps/browser-harness --host 0.0.0.0",
    "browser:build": "vite build apps/browser-harness",
    "browser:preview": "vite preview apps/browser-harness --host 0.0.0.0",
    "dev": "bun run src/cli.ts",
    "harness": "bun run browser:build && bun run src/cli.ts harness serve",
    "tui": "bun run src/cli.ts tui",
    "start": "bun dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "effect": "^3.13.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/d3": "^7.4.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.10"
  },
  "engines": {
    "bun": ">=1.3.1"
  }
}
