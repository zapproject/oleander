{
  "name": "oleander",
  "version": "0.1.0",
  "description": "ZAP Witness Council CLI harness",
  "type": "module",
  "bin": {
    "zap": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "dev": "bun run src/cli.ts",
    "tui": "bun run src/cli.ts tui",
    "start": "bun dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "^3.13.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.3.1"
  }
}
